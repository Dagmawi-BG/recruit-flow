            "url": { "raw": "{{baseUrl}}/api/applications/{{appId}}/stage", "host": ["{{baseUrl}}"], "path": ["api", "applications", "{{appId}}", "stage"] }
          }
        },
        {
          "name": "Get Application by Id",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{candidateToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/applications/{{appId}}", "host": ["{{baseUrl}}"], "path": ["api", "applications", "{{appId}}"] }
          }
        }
      ]
    },
    {
      "name": "5. Unauthenticated (expect 401)",
      "item": [
        {
          "name": "List Jobs - No Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/jobs", "host": ["{{baseUrl}}"], "path": ["api", "jobs"] }
          }
        }
      ]
    }
  ]
